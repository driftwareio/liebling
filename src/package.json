{
  "name": "liebling-build",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "zip": "node package.mjs",
    "production": "npm run build && npm run zip",
    "check": "node check.mjs",
    "test": "node --test ../tests/*.test.mjs",
    "test:browser": "playwright test",
    "order-locales": "node order-locales.cjs",
    "audit": "node audit.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "sass": "1.106.1",
    "gscan": "6.6.1",
    "archiver": "8.0.0",
    "@playwright/test": "1.64.1"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "source-map-js": "1.2.2"
  }
}
